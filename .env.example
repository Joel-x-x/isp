# App
NODE_ENV=production
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://isp_user:strong_password_here@postgres:5432/isp
DB_USER=isp_user
DB_PASSWORD=strong_password_here
DB_NAME=isp

# WispHub
WISPHUB_API_URL=https://api.wisphub.net/api
WISPHUB_API_KEY=your_wisphub_api_key_here

# Evolution API
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=your_evolution_api_key_here
EVOLUTION_INSTANCE_NAME=isp

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Notificaciones
BATCH_SIZE=20
DELAY_MIN_MS=15000
DELAY_MAX_MS=45000
BATCH_PAUSE_MIN_MS=180000
BATCH_PAUSE_MAX_MS=300000
CRON_MORNING=0 9 * * 1-6
CRON_AFTERNOON=0 15 * * 1-6
CRON_TIMEZONE=America/Mexico_City
COUNTRY_CODE=52

# Seguridad
WEBHOOK_SECRET=cambiar_por_secreto_fuerte

# Dry run — true: loggea mensajes sin enviar. false (o ausente): envía real
DRY_RUN=false
